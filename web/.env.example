# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://nwokedilegal.com
# Principal's full name exactly as people search for it (enables the Person schema)
NEXT_PUBLIC_PRINCIPAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Direct lines beside the enquiry form, in international format (e.g. +2348012345678)
NEXT_PUBLIC_PHONE=
# Only if WhatsApp uses a different number from the phone line
NEXT_PUBLIC_WHATSAPP=

# Consultation form → email (Resend). Without these, production shows a "please email us" message.
RESEND_API_KEY=
CONSULT_INBOX=
CONSULT_FROM="Nwokedi Legal <enquiries@nwokedilegal.com>"

# Cloudflare Turnstile (spam protection). Optional until launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Social profiles (full URLs) — shown in the footer and linked to her search profile
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_X=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_YOUTUBE=

# ── Supabase (database + private book storage) ─────────────────────
# Dashboard → Project Settings → API. SERVER ONLY: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack ───────────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Use the TEST secret key until launch.
PAYSTACK_SECRET_KEY=

# ── Book delivery ──────────────────────────────────────────────────
# Sender for download emails (domain must be verified in Resend), e.g. "Nwokedi Legal <books@nwokedilegal.com>"
BOOKS_FROM=
# Public site origin used in download links (defaults to NEXT_PUBLIC_SITE_URL)
PUBLIC_ORIGIN=

# Set to 1 on preview/review deployments so search engines never index them
SITE_NOINDEX=
