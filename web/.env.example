# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://nwokedilegal.com
# Principal's full name exactly as people search for it (enables the Person schema)
NEXT_PUBLIC_PRINCIPAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Consultation form → email (Resend). Without these, production shows a "please email us" message.
RESEND_API_KEY=
CONSULT_INBOX=
CONSULT_FROM="Nwokedi Legal <enquiries@nwokedilegal.com>"

# Cloudflare Turnstile (spam protection). Optional until launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
